# Gradle / Android Studio
.gradle/
build/
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/
.DS_Store

# Local SDK path and build-time secrets (see local.properties.example)
local.properties

# Release signing - never commit
keystore.properties
*.jks
*.keystore

# Android Studio "Generate Signed Bundle / APK" output
app/release/

# Temp AAB staging for browser upload (don't commit build artifacts long-term)
release-staging/

supabase/.temp/

# Play Store recording intermediates (keep only *-final.mp4 committed)
playstore/video/handyai-disclosure-raw.mp4
playstore/video/handyai-disclosure.mp4
playstore/video/handyai-disclosure-v2.mp4

# Transient session artifacts (Play Console screenshots, polling logs)
.claude/play-console-*.png
.claude/tester-progress.log
.claude/*.tmp
