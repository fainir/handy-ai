<?xml version="1.0" encoding="utf-8"?>
<!--
  Background for the big 6-character setup code display on KeySetupActivity.
  Inverted from the app's normal palette so the code reads as a high-
  contrast prompt. Rounded corners match the app's button/card radius.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_elevated" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="@color/border_soft" />
</shape>
