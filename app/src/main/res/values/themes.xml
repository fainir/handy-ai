<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ClaudePhoneAgent" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSurface">@color/bg_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/bg</item>
        <item name="android:navigationBarColor" tools:targetApi="o_mr1">@color/bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!--
      High-contrast variant for low-vision users. Pure white on pure black,
      higher contrast than the default cream-on-ink palette. Activated by
      AccessibilityHelper.applyTheme() reading the high_contrast preference.
      Honors WCAG 2.1 AAA contrast requirements (21:1 ratio).
    -->
    <style name="Theme.ClaudePhoneAgent.HighContrast" parent="Theme.ClaudePhoneAgent">
        <item name="colorPrimary">#FFFFFFFF</item>
        <item name="colorPrimaryVariant">#FFFFFFFF</item>
        <item name="colorOnPrimary">#FF000000</item>
        <item name="colorSecondary">#FFFFFFFF</item>
        <item name="colorOnSecondary">#FF000000</item>
        <item name="colorSurface">#FF000000</item>
        <item name="colorOnSurface">#FFFFFFFF</item>
        <item name="colorOnBackground">#FFFFFFFF</item>
        <item name="android:colorBackground">#FF000000</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#FFFFFFFF</item>
        <item name="android:textColorHint">#FFCCCCCC</item>
        <item name="android:statusBarColor" tools:targetApi="l">#FF000000</item>
        <item name="android:navigationBarColor" tools:targetApi="o_mr1">#FF000000</item>
    </style>
</resources>
